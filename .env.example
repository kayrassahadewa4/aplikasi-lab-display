# ====================================================================
# KONFIGURASI LINGKUNGAN INFRASTRUKTUR (ENVIRONMENT VARIABLES)
# Sistem Display Jadwal Laboratorium & Monitoring Terpadu
# ====================================================================
# Salin file ini menjadi .env sebelum menjalankan docker compose:
# cp .env.example .env

# --------------------------------------------------------------------
# 1. KONFIGURASI DATABASE POSTGRESQL
# --------------------------------------------------------------------
# Username untuk database PostgreSQL
POSTGRES_USER=postgres

# Password database (Ganti dengan password yang kuat di lingkungan produksi)
POSTGRES_PASSWORD=postgres_secure_pass_2026

# Nama database yang akan dibuat otomatis
POSTGRES_DB=lab_display

# Port PostgreSQL di komputer host (default: 5432)
POSTGRES_PORT=5432


# --------------------------------------------------------------------
# 2. KONFIGURASI BACKEND API (NestJS)
# --------------------------------------------------------------------
# Port Backend di komputer host (default: 3000)
BACKEND_PORT=3000

# Kunci rahasia untuk tanda tangan JWT Auth (Minimal 32 karakter acak di produksi)
JWT_SECRET=k4yr4_s4h4d3w4_super_secret_jwt_key_lab_display_2026

# Masa berlaku token akses
JWT_EXPIRATION=1d

# Pengaturan CORS (gunakan * untuk mengizinkan semua, atau domain spesifik seperti http://192.168.1.100)
CORS_ORIGIN=*

# Jalankan database seed otomatis (Role, User admin/laboran/siswa, Lab default)
# Set true pada pemasangan pertama kali, set false setelah sistem stabil
RUN_SEED=true


# --------------------------------------------------------------------
# 3. KONFIGURASI FRONTEND WEB & DISPLAY KIOSK
# --------------------------------------------------------------------
# Port Frontend di komputer host (80 untuk HTTP standar, atau 8080 jika port 80 dipakai)
FRONTEND_PORT=80

# Base URL API untuk frontend
# Kosongkan atau gunakan /api agar melewati Nginx reverse proxy internal
VITE_API_BASE_URL=/api

# WebSocket URL untuk real-time update TV Display
# Kosongkan agar otomatis menggunakan host yang sedang diakses browser
VITE_WS_URL=
